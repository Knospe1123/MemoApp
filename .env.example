# PostgreSQL (Neon, Vercel Postgres, Supabase, Railway, etc.)
# Example Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

JWT_SECRET="use-a-long-random-string-at-least-32-chars"

# Browser origin for local dev (Vite). Production also matches *.vercel.app in server CORS.
CLIENT_ORIGIN="http://localhost:5173"

PORT=4000
